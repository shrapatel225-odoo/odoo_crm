<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_ss_lead_convert_view_form" model="ir.ui.view">
        <field name="name">crm.ss.lead.convert.form</field>
        <field name="model">crm.ss.lead.convert</field>
        <field name="arch" type="xml">
            <form string="Convert Lead" class="o_ss_smart o_ss_convert_dialog">
                <field name="lead_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <div class="o_ss_convert_section">
                    <div class="o_ss_convert_section_title"><i class="oi" data-icon="business" title="Company"/> Account</div>
                    <field name="account_action" widget="radio" options="{'horizontal': true}" nolabel="1"/>
                    <group>
                        <field name="account_name" invisible="account_action != 'create'" required="account_action == 'create'"/>
                        <field name="account_id" invisible="account_action != 'existing'" required="account_action == 'existing'"
                            context="{'default_is_company': True}"/>
                        <field name="suggested_account_count" string="Similar accounts" readonly="1"
                            invisible="account_action != 'create' or not suggested_account_count"/>
                    </group>
                </div>
                <div class="o_ss_convert_section">
                    <div class="o_ss_convert_section_title"><i class="oi" data-icon="person" title="Contact"/> Contact</div>
                    <field name="contact_action" widget="radio" options="{'horizontal': true}" nolabel="1"/>
                    <group>
                        <field name="contact_name" invisible="contact_action != 'create'"/>
                        <field name="contact_id" invisible="contact_action != 'existing'" required="contact_action == 'existing'"/>
                    </group>
                </div>
                <div class="o_ss_convert_section">
                    <div class="o_ss_convert_section_title"><i class="oi" data-icon="handshake" title="Opportunity"/> Opportunity</div>
                    <field name="opportunity_action" widget="radio" options="{'horizontal': true}" nolabel="1"/>
                    <group>
                        <field name="opportunity_name" invisible="opportunity_action != 'create'" required="opportunity_action == 'create'"/>
                        <field name="merge_opportunity_id" invisible="opportunity_action != 'merge'" required="opportunity_action == 'merge'"/>
                    </group>
                    <div invisible="not suggested_opportunity_ids" class="alert alert-info mb-2" role="status">
                        <i class="oi" data-icon="info" title="Info"/> Matching open opportunities found for this lead:
                        <field name="suggested_opportunity_ids" widget="many2many_tags" readonly="1"/>
                    </div>
                </div>
                <group>
                    <group>
                        <field name="user_id" string="Record Owner" widget="many2one_avatar_user"/>
                    </group>
                    <group>
                        <field name="team_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_convert" string="Convert" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
