<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Default lead scoring model (fit + engagement + value), max 100 points.
         noupdate: administrators can freely adapt the rules. -->
    <data noupdate="1">
        <record id="ss_scoring_rule_email" model="crm.ss.scoring.rule">
            <field name="name">Email address provided</field>
            <field name="sequence">10</field>
            <field name="category">fit</field>
            <field name="domain">[("email_from", "!=", False)]</field>
            <field name="points">10</field>
        </record>
        <record id="ss_scoring_rule_phone" model="crm.ss.scoring.rule">
            <field name="name">Phone number provided</field>
            <field name="sequence">20</field>
            <field name="category">fit</field>
            <field name="domain">[("phone", "!=", False)]</field>
            <field name="points">10</field>
        </record>
        <record id="ss_scoring_rule_company" model="crm.ss.scoring.rule">
            <field name="name">Company known</field>
            <field name="sequence">30</field>
            <field name="category">fit</field>
            <field name="domain">["|", ("partner_name", "!=", False), ("partner_id.parent_id", "!=", False)]</field>
            <field name="points">10</field>
        </record>
        <record id="ss_scoring_rule_function" model="crm.ss.scoring.rule">
            <field name="name">Job position known</field>
            <field name="sequence">40</field>
            <field name="category">fit</field>
            <field name="domain">[("function", "!=", False)]</field>
            <field name="points">5</field>
        </record>
        <record id="ss_scoring_rule_website" model="crm.ss.scoring.rule">
            <field name="name">Website provided</field>
            <field name="sequence">50</field>
            <field name="category">fit</field>
            <field name="domain">[("website", "!=", False)]</field>
            <field name="points">5</field>
        </record>
        <record id="ss_scoring_rule_customer" model="crm.ss.scoring.rule">
            <field name="name">Linked to a contact</field>
            <field name="sequence">60</field>
            <field name="category">fit</field>
            <field name="domain">[("partner_id", "!=", False)]</field>
            <field name="points">10</field>
        </record>
        <record id="ss_scoring_rule_campaign" model="crm.ss.scoring.rule">
            <field name="name">Generated by a campaign</field>
            <field name="sequence">70</field>
            <field name="category">engagement</field>
            <field name="domain">[("campaign_id", "!=", False)]</field>
            <field name="points">10</field>
        </record>
        <record id="ss_scoring_rule_activity" model="crm.ss.scoring.rule">
            <field name="name">Activity planned</field>
            <field name="sequence">80</field>
            <field name="category">engagement</field>
            <field name="domain">[("activity_ids", "!=", False)]</field>
            <field name="points">10</field>
        </record>
        <record id="ss_scoring_rule_priority" model="crm.ss.scoring.rule">
            <field name="name">High priority (2 stars or more)</field>
            <field name="sequence">90</field>
            <field name="category">engagement</field>
            <field name="domain">[("priority", "in", ["2", "3"])]</field>
            <field name="points">15</field>
        </record>
        <record id="ss_scoring_rule_revenue" model="crm.ss.scoring.rule">
            <field name="name">Expected revenue of 10,000 or more</field>
            <field name="sequence">100</field>
            <field name="category">value</field>
            <field name="domain">[("expected_revenue", "&gt;=", 10000)]</field>
            <field name="points">15</field>
        </record>
        <record id="ss_scoring_rule_bad_email" model="crm.ss.scoring.rule">
            <field name="name">Invalid email address</field>
            <field name="sequence">200</field>
            <field name="category">negative</field>
            <field name="domain">[("email_state", "=", "incorrect")]</field>
            <field name="points">-20</field>
        </record>
        <record id="ss_scoring_rule_blacklisted" model="crm.ss.scoring.rule">
            <field name="name">Email blacklisted (opted out)</field>
            <field name="sequence">210</field>
            <field name="category">negative</field>
            <field name="domain">[("is_blacklisted", "=", True)]</field>
            <field name="points">-30</field>
        </record>
    </data>
</odoo>
